<Window x:Class="GuestVoiceStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:GuestVoiceStudio"
        mc:Ignorable="d"
        Title="お客様の声・改善管理 | Guest Voice Studio" Height="900" Width="1440"
        Icon="Assets/app.ico"
        Background="#FAF6EE">
    <Grid>
        <wv2:WebView2 x:Name="Browser" />
        <!--
          Startup splash: shown until the web app finishes its first
          navigation (see NavigationCompleted in MainWindow.xaml.cs). Uses the
          official 休暇村 wordmark (Assets/logo.png, white background keyed
          to transparent) supplied by 休暇村協会.
        -->
        <Border x:Name="LoadingOverlay" Background="#FAF6EE">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="Assets/logo.png" Width="240" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="声を重ねて、ときめく旅の景色へ。" FontSize="15" Foreground="#B28A4A" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Guest Voice Studio" FontSize="20" FontWeight="Bold" Foreground="#17324D" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="起動しています…" FontSize="12" Foreground="#6B6455" Margin="0,14,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!--
          Always-visible zoom control (－ / 100% / ＋), bottom-right. Ctrl+
          MouseWheel and Ctrl+ +/- still work (WebView2's own gesture), but
          feedback was that not everyone knows those shortcuts exist — this
          gives every user a way to zoom without needing to know them. The
          percentage label also stays in sync when zoom changes via the
          keyboard/wheel gesture instead of these buttons (see the polling
          timer in MainWindow.xaml.cs).
        -->
        <Border Background="#17324D" CornerRadius="8" Padding="4"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Opacity="0.92">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ZoomOutBtn" Content="－" Width="30" Height="26" FontSize="14" FontWeight="Bold"
                        Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="縮小"/>
                <Button x:Name="ZoomResetBtn" Width="56" Height="26" FontSize="13" FontWeight="Bold"
                        Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"
                        ToolTip="クリックで100%に戻す" Margin="2,0">
                    <TextBlock x:Name="ZoomIndicatorText" Text="100%"/>
                </Button>
                <Button x:Name="ZoomInBtn" Content="＋" Width="30" Height="26" FontSize="14" FontWeight="Bold"
                        Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="拡大"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
