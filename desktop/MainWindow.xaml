<Window x:Class="GuestVoiceStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:GuestVoiceStudio"
        mc:Ignorable="d"
        Title="お客様の声・改善管理 | Guest Voice Studio" Height="900" Width="1440"
        Icon="Assets/app.ico"
        Background="#FAF6EE">
    <Grid>
        <!--
          Browser starts Hidden, not just underneath the splash: WebView2 is a
          windowed (HWND-hosted) control, and windowed controls always paint
          ON TOP of ordinary WPF siblings regardless of XAML z-order (the
          classic "airspace" problem). If Browser were merely behind
          LoadingOverlay in z-order but still Visible, its own blank/loading
          surface would still show through on top of our splash the moment
          WebView2 starts painting — which is exactly what real-machine
          testing saw ("起動画面(一瞬)+真っ白な画面"). Keeping it Hidden
          until NavigationCompleted avoids that entirely; see
          MainWindow.xaml.cs.
        -->
        <wv2:WebView2 x:Name="Browser" Visibility="Hidden" />
        <!--
          Startup splash: shown until the web app finishes its first
          navigation (see NavigationCompleted in MainWindow.xaml.cs). Uses the
          official 休暇村 wordmark (Assets/logo.png, white background keyed
          to transparent) supplied by 休暇村協会.
        -->
        <Border x:Name="LoadingOverlay" Background="#FAF6EE">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="Assets/logo.png" Width="240" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="声を重ねて、ときめく旅の景色へ。" FontSize="15" Foreground="#B28A4A" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Guest Voice Studio" FontSize="20" FontWeight="Bold" Foreground="#17324D" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="起動しています…" FontSize="12" Foreground="#6B6455" Margin="0,14,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
